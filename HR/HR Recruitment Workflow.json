        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Candidate: ' + $('Loop Over Candidates').item.json['Name'] +\n'\\nRole applied for: ' + $('Loop Over Candidates').item.json['Role Applied For'] +\n'\\nGPA: ' + $('Loop Over Candidates').item.json['GPA'] +\n'\\nLinkedIn (reference only, not scraped): ' + ($('Loop Over Candidates').item.json['LinkedIn URL'] || 'n/a') +\n'\\n\\n=== CV TEXT ===\\n' + ($('Extract CV Text').item.json.text || 'CV could not be extracted.') +\n'\\n\\n=== GITHUB SIGNAL ===\\n' + $json.github_summary }}"
            }
          ]
        },
        "options": {
          "includeMergedResponse": true,
          "system": "You are an expert technical recruiter. Score a candidate for the role they applied to.\nWeighting: CV fit 40%, GitHub 30%, GPA 20%, presentation/communication 10%.\nReturn ONLY strict minified JSON, no markdown, no code fences, with exactly these keys:\n{\"score\": <number 0-100>, \"cv_fit_notes\": \"<string>\", \"github_notes\": \"<string>\", \"gpa_contribution\": \"<string>\", \"overall_reasoning\": \"<string>\"}",
          "maxTokens": 1500,
          "temperature": 0
        }
      },
      "id": "8f59dfa8-0d95-4a64-8d54-f71d814c9bc5",
      "name": "Score Candidate",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        560,
        -176
      ],
      "credentials": {
        "anthropicApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.merged_response || ($json.content && $json.content[0] && $json.content[0].text) || '';\nlet parsed = {};\ntry {\n  const cleaned = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n  parsed = JSON.parse(cleaned.slice(start, end + 1));\n} catch (e) {\n  parsed = { score: 0, cv_fit_notes: 'Parse error', github_notes: '', gpa_contribution: '', overall_reasoning: 'Could not parse model output: ' + String(raw).slice(0, 300) };\n}\nconst c = $('Loop Over Candidates').item.json;\nreturn [{ json: {\n  Name: c['Name'],\n  Email: c['Email'],\n  'Role Applied For': c['Role Applied For'],\n  GPA: c['GPA'],\n  'LinkedIn URL': c['LinkedIn URL'] || '',\n  'GitHub URL': c['GitHub URL'] || '',\n  row_number: c['row_number'],\n  score: Number(parsed.score) || 0,\n  cv_fit_notes: parsed.cv_fit_notes || '',\n  github_notes: parsed.github_notes || '',\n  gpa_contribution: parsed.gpa_contribution || '',\n  overall_reasoning: parsed.overall_reasoning || '',\n} }];"
      },
