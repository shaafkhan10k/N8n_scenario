    {
      "parameters": {
        "jsCode": "const repos = Array.isArray($json) ? $json : ($json.body || []);\nlet summary = 'No public repositories found.';\nif (Array.isArray(repos) && repos.length) {\n  const top = repos\n    .filter(r => !r.fork)\n    .sort((a, b) => (b.stargazers_count || 0) - (a.stargazers_count || 0))\n    .slice(0, 15)\n    .map(r => `- ${r.name} (${r.language || 'n/a'}, star ${r.stargazers_count || 0}): ${(r.description || '').slice(0, 120)}`);\n  const langs = [...new Set(repos.map(r => r.language).filter(Boolean))];\n  summary = `Public repos: ${repos.length}. Languages: ${langs.join(', ') || 'n/a'}.\\nTop repos:\\n${top.join('\\n')}`;\n}\nreturn [{ json: { github_summary: summary } }];"
      },
